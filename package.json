{
  "name": "bexxcv",
  "version": "1.1.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc && pnpm copy-files",
    "gen-webgl": "node scripts/gen-webgl.cjs",
    "copy-files": "cp -r src/data-files dist/data-files",
    "test": "vitest",
    "check": "biome check",
    "fetch": "node dist/__main__.js fetch",
    "prepublishOnly": "pnpm build",
    "update-data": "node scripts/update-data.mjs",
    "doctor": "node dist/__main__.js doctor"
  },
  "bin": "dist/__main__.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "keywords": [
    "camoufox",
    "playwright",
    "firefox",
    "stealth",
    "fingerprint",
    "anti-detection"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fidzzcodex-me/bexxcv"
  },
  "bugs": {
    "url": "https://github.com/fidzzcodex-me/bexxcv/issues"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "license": "MPL-2.0",
  "description": "High-performance stealth Firefox automation. Fork of camoufox-js with parallel IP resolution, crypto-grade fingerprint seeds, exponential backoff, and zero-config Xvfb.",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.1",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "fingerprint-generator": "^2.1.86",
    "glob": "^13.0.0",
    "impit": "^0.14.1",
    "language-tags": "^2.0.1",
    "maxmind": "^5.0.0",
    "pretty-bytes": "^7.1.0",
    "ua-parser-js": "^2.0.10",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "^3.11.6",
    "@types/language-tags": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/xml2js": "^0.4.14",
    "playwright-core": "<1.63.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "playwright-core": "<1.63.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.4",
      "onFail": "warn"
    }
  },
  "pnpm": {
    "overrides": {
      "vite": ">=8.0.16"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./xvfb": {
      "types": "./dist/xvfb.d.ts",
      "import": "./dist/xvfb.js",
      "require": "./dist/xvfb.js",
      "default": "./dist/xvfb.js"
    },
    "./virtdisplay": {
      "types": "./dist/virtdisplay.d.ts",
      "import": "./dist/virtdisplay.js",
      "require": "./dist/virtdisplay.js",
      "default": "./dist/virtdisplay.js"
    },
    "./exceptions": {
      "types": "./dist/exceptions.d.ts",
      "import": "./dist/exceptions.js",
      "require": "./dist/exceptions.js",
      "default": "./dist/exceptions.js"
    },
    "./selfupdate": {
      "types": "./dist/selfupdate.d.ts",
      "import": "./dist/selfupdate.js",
      "require": "./dist/selfupdate.js",
      "default": "./dist/selfupdate.js"
    }
  }
}
