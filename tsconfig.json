{
 "compilerOptions": {
  "target": "ES2022",
  "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
  "module": "Node16",
  "moduleResolution": "node16",
  "preserveConstEnums": true,
  "sourceMap": false,
  "removeComments": false,
  "outDir": "./dist",
  "declaration": true,
  "strict": true,
  "skipLibCheck": true
 },
 "include": ["src/**/*.ts"]
}
